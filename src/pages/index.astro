---
import FeatureGrid from '../components/home/FeatureGrid.astro';
import FooterSection from '../components/home/FooterSection.astro';
import HeroSection from '../components/home/HeroSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'claude-diag | Redacted Claude Code diagnostics';
const description =
	'Run claude-diag locally with curl -fsSL https://sh.cdiag.link | bash to generate a redacted Claude Code diagnostic report.';
---

<BaseLayout title={title} description={description}>
		<main>
			<HeroSection />
			<FeatureGrid />
		</main>
	<FooterSection />
</BaseLayout>
